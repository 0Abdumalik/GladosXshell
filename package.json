    "build:release": "node scripts/build-setup.mjs release",
    "lint": "biome check .",
    "i18n": "node scripts/check-i18n.mjs",
    "extract:i18n": "node scripts/extract-i18n.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "biome check . && tsc && vitest run && node scripts/check-i18n.mjs"
  },
